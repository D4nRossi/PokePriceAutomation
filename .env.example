# Copie para .env e preencha. O .env nunca vai para o git.

# --- Telegram ---
# Token do @BotFather
TELEGRAM_BOT_TOKEN=
# ID do grupo (começa com -100...). Descubra com:
#   docker compose run --rm monitor python -m monitor.main --descobrir-chat
TELEGRAM_CHAT_ID=

# --- Papel desta máquina ---
# Só UMA máquina do grupo tem LIDER=true. As outras ficam de reserva e só
# enviam se o líder ficar FAILOVER_MINUTOS sem dar sinal de vida.
LIDER=false
FAILOVER_MINUTOS=15
# Nome que aparece nas mensagens. Tem que ser diferente em cada máquina.
# Vazio = nome do computador.
MAQUINA=

# --- Regras ---
INTERVALO_SEGUNDOS=300
FALHAS_PARA_ALERTA_CEGO=3
# Teto de preço = sugerido + tolerância
TOLERANCIA_REAIS=1.00
# Hora (São Paulo) a partir da qual sai o "monitor vivo" diário
HORA_HEARTBEAT=9

# --- Banco ---
POSTGRES_PASSWORD=pokemon-local
POSTGRES_PORTA_LOCAL=5433

# --- Mercado Livre (fonte desligada até o coletor ser escrito) ---
# App criado em developers.mercadolivre.com.br: App ID e Secret Key
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_ACCESS_TOKEN=
